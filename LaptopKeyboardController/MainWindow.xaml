<Window x:Class="LaptopKeyboardController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop Keyboard Controller"
        Height="450"
        Width="600">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Application title -->
        <TextBlock Grid.Row="0"
                   Text="Keyboard Device Manager"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Control buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">

            <Button Content="Save Initial Scan"
                    Width="160"
                    Height="40"
                    Click="SaveScan_Click"
                    Margin="0,0,10,0"/>

            <Button Content="Compare Devices"
                    Width="160"
                    Height="40"
                    Click="CompareDevices_Click"/>


            <Button Content="Inspect Devices"
                Width="160"
                Height="40"
                Click="InspectDevices_Click"
                Margin="10,0,0,0"/>


        </StackPanel>

        <!-- Device list label -->
        <TextBlock Grid.Row="2"
                   Text="Detected Devices:"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Results -->
        <TextBox Grid.Row="3"
                 x:Name="KeyboardList"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

    </Grid>
</Window>
